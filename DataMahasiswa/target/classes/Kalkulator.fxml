<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="320.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.KalkulatorController">
   <children>
      <Label layoutX="160.0" layoutY="20.0" text="Kalkulator" />
      <Label layoutX="50.0" layoutY="70.0" text="Angka 1" />
      <TextField fx:id="txtAngka1" layoutX="130.0" layoutY="66.0" />
      <Label layoutX="50.0" layoutY="110.0" text="Angka 2" />
      <TextField fx:id="txtAngka2" layoutX="130.0" layoutY="106.0" />
      <Button fx:id="btnTambah" layoutX="50.0" layoutY="160.0" mnemonicParsing="false" onAction="#handleTambah" prefWidth="60.0" text="+" />
      <Button fx:id="btnKurang" layoutX="125.0" layoutY="160.0" mnemonicParsing="false" onAction="#handleKurang" prefWidth="60.0" text="-" />
      <Button fx:id="btnKali" layoutX="200.0" layoutY="160.0" mnemonicParsing="false" onAction="#handleKali" prefWidth="60.0" text="x" />
      <Button fx:id="btnBagi" layoutX="275.0" layoutY="160.0" mnemonicParsing="false" onAction="#handleBagi" prefWidth="60.0" text="/" />
      <Label layoutX="50.0" layoutY="220.0" text="Hasil:" />
      <Label fx:id="lblHasil" layoutX="130.0" layoutY="220.0" text="0" />
      <Button fx:id="btnReset" layoutX="130.0" layoutY="265.0" mnemonicParsing="false" onAction="#handleReset" text="Reset" />
   </children>
</AnchorPane>
