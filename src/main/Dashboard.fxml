<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashboardController">
   <children>
      <Label layoutX="20.0" layoutY="20.0" text="Data Mahasiswa" />
      <Label layoutX="20.0" layoutY="70.0" text="Nama" />
      <TextField fx:id="txtNama" layoutX="80.0" layoutY="66.0" prefWidth="160.0" />
      <Label layoutX="20.0" layoutY="110.0" text="NIM" />
      <TextField fx:id="txtNim" layoutX="80.0" layoutY="106.0" prefWidth="160.0" />
      <Label layoutX="20.0" layoutY="150.0" text="E-mail" />
      <TextField fx:id="txtEmail" layoutX="80.0" layoutY="146.0" prefWidth="160.0" />
      <Button fx:id="btnAdd" layoutX="80.0" layoutY="190.0" mnemonicParsing="false" onAction="#handleAdd" text="Add" />
      <Button fx:id="btnDelete" layoutX="140.0" layoutY="190.0" mnemonicParsing="false" onAction="#handleDelete" text="Delete" />
      <TableView fx:id="tableMahasiswa" layoutX="260.0" layoutY="66.0" prefHeight="300.0" prefWidth="370.0">
         <columns>
            <TableColumn fx:id="colNama" prefWidth="120.0" text="Nama" />
            <TableColumn fx:id="colNim" prefWidth="90.0" text="NIM" />
            <TableColumn fx:id="colEmail" prefWidth="150.0" text="E-mail" />
         </columns>
      </TableView>
   </children>
</AnchorPane>